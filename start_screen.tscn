[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://start_screen.gd" id="1_start_screen_script"]
[ext_resource type="AudioStream" path="res://audio/popcorn_loop.wav" id="2_popcorn_loop_audio"]
[ext_resource type="Texture2D" path="res://textures/start_screen_kernel.png" id="3_start_screen_kernel_texture"]
[ext_resource type="Script" path="res://title_flicker.gd" id="4_title_flicker_script"]

[node name="StartScreen" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_start_screen_script")

[node name="PopSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_popcorn_loop_audio")

[node name="Background" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_start_screen_kernel_texture")
expand_mode = 1
stretch_mode = 6

[node name="BackgroundTint" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.06, 0.22)

[node name="Title" type="Label" parent="."]
anchor_left = 0.5
anchor_top = 0.11
anchor_right = 0.5
anchor_bottom = 0.11
offset_left = -300.0
offset_top = -50.0
offset_right = 300.0
offset_bottom = 50.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.3, 1, 0.4, 1)
theme_override_colors/font_outline_color = Color(0.02, 0.05, 0.02, 1)
theme_override_colors/font_shadow_color = Color(0.35, 1, 0.45, 0.6)
theme_override_constants/outline_size = 8
theme_override_constants/shadow_outline_size = 16
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 0
theme_override_font_sizes/font_size = 60
horizontal_alignment = 1
vertical_alignment = 1
text = "MICROSCAPE"
script = ExtResource("4_title_flicker_script")

[node name="Subtitle" type="Label" parent="."]
anchor_left = 0.5
anchor_top = 0.23
anchor_right = 0.5
anchor_bottom = 0.23
offset_left = -320.0
offset_top = -30.0
offset_right = 320.0
offset_bottom = 30.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.82, 0.85, 0.82, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.85)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 18
